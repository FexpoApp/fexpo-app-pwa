# UUID real del evento (no el slug fipaz-2026).
VITE_EVENT_ID=
# OAuth web Client ID público. Autorizar el origen HTTPS y localhost:5174/4174 en Google Cloud.
VITE_GOOGLE_CLIENT_ID=492704011109-3479bq36uucvnqlsjrlfatur1fb3kjhu.apps.googleusercontent.com
